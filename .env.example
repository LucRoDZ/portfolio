# Canonical origin used for metadata, sitemap and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://lucaszivan.app

# Optional "Book a call" link (Cal.com, Calendly…). Button hidden when empty.
NEXT_PUBLIC_CALENDAR_URL=

# Cookieless analytics, off by default. Set to "plausible" or "umami".
NEXT_PUBLIC_ANALYTICS=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional, for a self-hosted Plausible or the proxied script variant.
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
