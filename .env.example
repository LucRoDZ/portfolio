# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Copy to .env (server) or .env.local (local dev). The real .env lives only on the server, chmod 600,
# and is gitignored. Read by deploy.sh and docker compose. No secret is ever baked into the image.
# ─────────────────────────────────────────────────────────────────────────────────────────────────

# ── Deployment (deploy.sh) ──────────────────────────────────────────────────────────────────────
DOMAIN=lucaszivan.app
# standalone   : Caddy container on ports 80/443 with automatic Let's Encrypt (needs free ports).
# shared-proxy : no Caddy; the app joins SHARED_PROXY_NETWORK behind a proxy that already runs.
PROXY_MODE=standalone
# Let's Encrypt account e-mail (standalone mode).
ACME_EMAIL=
# Branch deploy.sh deploys. This repository's default branch is currently "master".
DEPLOY_BRANCH=main
# Docker network of the existing reverse proxy (shared-proxy mode only).
SHARED_PROXY_NETWORK=
# Traefik certificate resolver name (shared-proxy mode with Traefik only).
TRAEFIK_CERTRESOLVER=letsencrypt
# Host ports for Caddy (standalone mode).
HTTP_PORT=80
HTTPS_PORT=443
# Abort a deploy if `git verify-commit` fails on the commit to deploy (needs the signer's key on the server).
REQUIRE_SIGNED_COMMITS=false
# Abort if the Docker disk has less free space than this (MB).
MIN_FREE_DISK_MB=2048
# Seconds to wait for a new container to report healthy.
HEALTH_TIMEOUT=60
# SHA-tagged images kept for --rollback.
KEEP_IMAGES=3
# Compose project name; also the image name unless IMAGE_NAME is set. Change only to run two copies on one host.
COMPOSE_PROJECT_NAME=lucaszivan-portfolio
IMAGE_NAME=

# ── Build-time site settings (public: inlined into the pages) ───────────────────────────────────
# Canonical origin for metadata/sitemap. deploy.sh derives it from DOMAIN when empty.
NEXT_PUBLIC_SITE_URL=
# Optional "Book a call" link (Cal.com, Calendly…). Button hidden when empty.
NEXT_PUBLIC_CALENDAR_URL=
# Cookieless analytics, off by default: "plausible" or "umami". The CSP allows only this origin.
NEXT_PUBLIC_ANALYTICS=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# ── Optional self-hosted Umami (compose profile "analytics", standalone mode) ───────────────────
ANALYTICS_SELF_HOSTED=false
# e.g. stats.lucaszivan.app (needs its own DNS record). Then set NEXT_PUBLIC_ANALYTICS=umami and
# NEXT_PUBLIC_UMAMI_SRC=https://stats.lucaszivan.app/script.js after creating the site in Umami.
ANALYTICS_DOMAIN=
# Runtime secrets — server .env only. Generate with: openssl rand -hex 32
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# ── Local testing of deploy.sh only — leave empty on the server ─────────────────────────────────
# Base URL for the post-deploy smoke test (default https://$DOMAIN).
SMOKE_URL=
# "true" skips certificate validation in the smoke test (local self-signed certificates only).
SMOKE_INSECURE=false
