# Standalone mode (PROXY_MODE=standalone). Values come from the server's .env through docker compose.
# Security headers (CSP, HSTS, …) are set by the app itself so they are identical in shared-proxy mode;
# the "?" defaults below only apply if a response lacks them.
{
	email {$ACME_EMAIL}
	admin localhost:2019
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		-Server
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
	}

	# Content-hashed build assets never change.
	@hashed path /_next/static/*
	header @hashed {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}

	reverse_proxy app:3000 {
		# While deploy.sh recreates the app container (~1 s), hold requests instead of returning 502.
		lb_try_duration 20s
		lb_try_interval 250ms
	}

	log {
		output stdout
		format console
	}
}

# Extra sites (e.g. self-hosted analytics), copied here by deploy.sh when enabled.
import /etc/caddy/sites-enabled/*.caddy
